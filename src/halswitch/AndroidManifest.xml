<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.syleront.opcamera.halswitch" android:versionCode="3" android:versionName="1.2">
    <!-- toasts are suppressed for apps whose notifications are off (default for new apps) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:allowBackup="false" android:hasCode="true">
        <!-- launcher icon = home-screen shortcut: tap switches the HAL, no UI -->
        <activity android:name=".ToggleActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".HalTileService" android:exported="true"
            android:label="@string/tile_label" android:icon="@drawable/ic_hal"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
    </application>
</manifest>
